# Obsidian Sync credentials for the obsidian-headless-sync container
# Real file is gitignored (root .gitignore: *.env) — never commit obsidian_headless.env.
#
# On the NAS this lives at:
#   /share/ContainerNew/lenie-env/obsidian_headless.env
#
# --- Required -----------------------------------------------------------

# One-time, INTERACTIVE token generation — this cannot be scripted/automated
# (it prompts for your Obsidian account email, password, and MFA code).
# Run this yourself on the NAS (or anywhere with Docker + network access),
# then paste the resulting token below:
#
#   docker run --rm -it --entrypoint get-token ghcr.io/belphemur/obsidian-headless-sync-docker:0.0.14
#
OBSIDIAN_AUTH_TOKEN=<paste-token-from-get-token-here>

# Exact name of the remote Obsidian Sync vault to sync.
VAULT_NAME=<your-vault-name>

# --- Optional -------------------------------------------------------------

# Only required if end-to-end encryption is enabled on the vault.
# If the password contains a '$', wrap it in single quotes so Docker Compose
# doesn't try to interpolate it as a variable reference.
VAULT_PASSWORD=

# Host UID/GID that should own the synced vault files (regular, non-rootless
# Docker on QNAP Container Station). Verify the real values on the NAS with
# `id` before deploying — do not assume 1000:1000.
PUID=1000
PGID=1000

# Device label shown in Obsidian Sync's device history.
DEVICE_NAME=lenie-nas
