# Secrets for the lenie-mcp container (ADR-030 Etap B1).
# Real file is gitignored (root .gitignore: *.env) -- never commit lenie_mcp.env.
#
# On the NAS this lives at:
#   /share/Container/lenie-env/lenie_mcp.env      (chmod 600)

# Service API key (kind=service) the container uses to call the Lenie backend.
# Prefer a dedicated key (imports/api_key_admin.py create --kind service --name lenie-mcp-nas) over reusing
# the key from the /lenie-obsidian-note skill, so it can be revoked on its own.
LENIE_API_KEY=<service-api-key>

# Bearer token clients must send to the MCP endpoint (>= 32 characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LENIE_MCP_TOKEN=<random-token>
