# CouchDB admin bootstrap credentials for the lenie-couchdb container.
# Real file is gitignored (root .gitignore: *.env) — never commit couchdb.env.
#
# On the NAS this lives at:
#   /share/ContainerNew/lenie-env/couchdb.env
#
# Same chicken-and-egg reason as minio.env (see nas.env.example): CouchDB
# needs its own admin user before anything (including this app's config
# loader) can reach it, so these two values live here rather than in Vault.
# Any future application-side consumer (sync worker, etc.) still reads its
# CouchDB connection credentials from Vault like everything else — see
# docs/adr/adr-024-couchdb-offline-capture-chrome-extension.md.
#
# Setting both COUCHDB_USER and COUCHDB_PASSWORD makes the official image
# auto-configure itself as a single-node instance on first start — no
# separate _cluster_setup call needed. Verify against
# https://docs.couchdb.org/en/stable/install/docker.html before relying on
# this if the image version changes.

COUCHDB_USER=lenie-admin
COUCHDB_PASSWORD=<your-couchdb-password>
